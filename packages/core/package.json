{
  "name": "@proteus-ui/core",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@proteus-ui/tokens": "workspace:*",
    "@react-aria/focus": "^3.19.0",
    "@react-aria/overlays": "^3.24.0",
    "@react-aria/tooltip": "^3.10.1"
  }
}
